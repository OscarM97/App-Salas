{
  "name": "salas-casa",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "PWA para que la familia reserve las salas de la casa sin traslapes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
