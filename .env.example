# Copia este archivo como .env.local (desarrollo) o pon estas variables en Vercel/Netlify.
# También sirven tal cual las líneas NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# que muestra el botón "Connect" de Supabase.
# Si las dejas vacías la app arranca en "Modo demo" (datos solo en este navegador).

# Supabase → Project Settings → API (o "Connect") → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
# En proyectos antiguos se llama "anon public". Es segura para el navegador:
# la seguridad real la ponen RLS + el código de la casa + los PINs.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
